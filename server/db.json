  "messages": [
    {
      "id": "m1",
      "conversationId": "conv1",
      "senderId": "u2",
      "text": "Hey Alex! Loved your latest post from the Dolomites.",
      "isRead": true,
      "createdAt": "2026-11-09T09:40:00Z"
    },
    {
      "id": "m2",
      "conversationId": "conv1",
      "senderId": "u1",
      "text": "Thanks Maya! The sunrise hike was freezing but totally worth it.",
      "isRead": true,
      "createdAt": "2026-11-09T09:55:00Z"
    },
    {
      "id": "m3",
      "conversationId": "conv1",
      "senderId": "u2",
      "text": "Are you planning to exhibit those prints in Tokyo next spring?",
      "isRead": false,
      "createdAt": "2026-11-09T10:15:00Z"
    },
    {
      "id": "m4",
      "conversationId": "conv2",
      "senderId": "u3",
      "text": "Hey Alex, are you trying out the new React 19 compiler features yet?",
      "isRead": true,
      "createdAt": "2026-11-08T16:00:00Z"
    },
    {
      "id": "m5",
      "conversationId": "conv2",
      "senderId": "u1",
      "text": "Yes! The automatic memoization is such a welcome upgrade.",
      "isRead": true,
      "createdAt": "2026-11-08T16:45:00Z"
    },
    {
      "id": "m6",
      "conversationId": "conv2",
      "senderId": "u3",
      "text": "Agreed. Let's catch up over coffee when you visit Berlin next month.",
      "isRead": true,
      "createdAt": "2026-11-08T17:40:00Z"
    },
    {
      "id": "m7",
      "conversationId": "conv3",
      "senderId": "u4",
      "text": "Alex, that sourdough starter recipe you asked about is finally written up!",
      "isRead": true,
      "createdAt": "2026-11-07T20:30:00Z"
    },
    {
      "id": "m8",
      "conversationId": "conv3",
      "senderId": "u1",
      "text": "Amazing! Can't wait to bake my first loaf this weekend.",
      "isRead": true,
      "createdAt": "2026-11-07T21:15:00Z"
    },
    {
      "id": "m9",
      "conversationId": "conv4",
      "senderId": "u7",
      "text": "Yo Alex! Did you ever fly the drone along the Kerry cliffs?",
      "isRead": true,
      "createdAt": "2026-11-06T18:00:00Z"
    },
    {
      "id": "m10",
      "conversationId": "conv4",
      "senderId": "u1",
      "text": "Not yet Liam! Gusts can be unpredictable, but it's high on my list.",
      "isRead": true,
      "createdAt": "2026-11-06T19:30:00Z"
    },
    {
      "id": "m11",
      "conversationId": "conv5",
      "senderId": "u8",
      "text": "Hello Alex! The pottery series inspired by your landscape palette is out.",
      "isRead": true,
      "createdAt": "2026-11-05T13:40:00Z"
    },
    {
      "id": "m12",
      "conversationId": "conv5",
      "senderId": "u1",
      "text": "The earthy tones look spectacular Priya! Congratulations.",
      "isRead": true,
      "createdAt": "2026-11-05T14:10:00Z"
    },
    {
      "id": "m13",
      "conversationId": "conv1",
      "senderId": "u1",
      "text": "I'd love to! Still finalizing dates with the gallery.",
      "isRead": true,
      "createdAt": "2026-11-09T10:18:00Z"
    },
    {
      "id": "m14",
      "conversationId": "conv1",
      "senderId": "u2",
      "text": "Keep me posted. We have plenty of studio space here for you.",
      "isRead": false,
      "createdAt": "2026-11-09T10:20:00Z"
    },
    {
      "id": "m15",
      "conversationId": "conv2",
      "senderId": "u3",
      "text": "I'll book a table at Five Elephant. Their cheesecake is legendary.",
      "isRead": true,
      "createdAt": "2026-11-08T18:00:00Z"
    },
    {
      "id": "m16",
      "conversationId": "conv3",
      "senderId": "u4",
      "text": "Make sure your kitchen temperature is around 24°C for bulk fermentation.",
      "isRead": true,
      "createdAt": "2026-11-07T21:40:00Z"
    },
    {
      "id": "m17",
      "conversationId": "conv4",
      "senderId": "u7",
      "text": "Let me know when you come over. I know hidden launch spots shielded from wind.",
      "isRead": true,
      "createdAt": "2026-11-06T20:10:00Z"
    },
    {
      "id": "m18",
      "conversationId": "conv5",
      "senderId": "u8",
      "text": "Sending a vase over to your studio this week!",
      "isRead": true,
      "createdAt": "2026-11-05T14:30:00Z"
    },
    {
      "id": "m19",
      "conversationId": "conv1",
      "senderId": "u2",
      "text": "Let me know if you need any local photography permits too.",
      "isRead": false,
      "createdAt": "2026-11-09T10:22:00Z"
    },
    {
      "id": "m20",
      "conversationId": "conv2",
      "senderId": "u1",
      "text": "Five Elephant it is. Talk soon Marcus!",
      "isRead": true,
      "createdAt": "2026-11-08T18:15:00Z"
    }
  ],
